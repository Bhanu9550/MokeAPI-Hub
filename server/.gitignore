# Dependency directories (Never upload node_modules)
node_modules/
jspm_packages/

# Environment variables and secrets (Crucial for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports (Crashed node instances)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data and storage databases
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented code coverage downloads
coverage/
.nyc_output/

# IDE / Editor specific configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata files
.DS_Store
Thumbs.db
